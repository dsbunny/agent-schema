	},
	"peerDependencies": {
		"@dsbunny/capdb-schema": "github:dsbunny/capdb-schema",
		"@dsbunny/recipe-schema": "github:dsbunny/recipe-schema",
		"@dsbunny/rmm-schema": "github:dsbunny/rmm-schema",
		"zod": "^4.3.0"
